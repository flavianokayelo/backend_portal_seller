{
  "name": "@7sete/integration-api",
  "version": "1.0.0",
  "private": true,
  "description": "Integration API for 7Sete Seller Portal — orchestrates 7Sete PHP and VendaExpress Node.js backends",
  "main": "dist/main.js",
  "scripts": {
    "build": "npx tsc",
    "dev": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs --test src/tests/**/*.test.ts",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "zod": "^3.24.1",
    "typescript": "^5",
    "@types/node": "^20",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.8",
    "@types/bcryptjs": "^2.4.6"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
